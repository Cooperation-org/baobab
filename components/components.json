{
  "about": "Every web component the team has. Human view: https://demos.linkedtrust.us/baobab/components/ . Rules for cards: https://github.com/Cooperation-org/baobab/blob/main/CONTRACT.md section 2. contract=true means it follows them.",
  "components": [
    {"tag": "lt-claims", "src": "https://demos.linkedtrust.us/baobab/components/lt-claims.js", "what": "Recent LinkedTrust claims, filtered, refreshed on a timer", "signin": false, "contract": true,
     "attributes": {"data-up": "LinkedTrust server, e.g. https://live.linkedtrust.us", "data-query": "text match", "data-filter": "ratings | credentials", "data-subject": "exact subject URI", "data-claim": "claim type", "data-issuer": "issuer id", "data-limit": "default 10", "data-refresh": "seconds, default 60, 0 = never"},
     "reads": ["GET /api/feed", "GET /api/claim"]},
    {"tag": "atproto-thread", "src": "https://demos.linkedtrust.us/baobab/components/atproto-thread.js", "what": "Replies to one Bluesky post, shown as comments on a page; people comment by replying on Bluesky", "signin": false, "contract": true,
     "attributes": {"data-up": "AT Proto app view, e.g. https://public.api.bsky.app", "data-post": "bsky.app post link or at:// URI", "data-depth": "default 3", "data-refresh": "seconds, default 60", "data-reply": "yes = show Reply on Bluesky; set only for a viewer signed in with Bluesky"},
     "reads": ["app.bsky.feed.getPostThread", "com.atproto.identity.resolveHandle"]},
    {"tag": "atproto-feed", "src": "https://demos.linkedtrust.us/baobab/components/atproto-feed.js", "what": "Latest posts from one Bluesky account", "signin": false, "contract": true,
     "attributes": {"data-up": "AT Proto app view", "data-actor": "handle or DID", "data-limit": "default 5", "data-replies": "yes to include replies", "data-refresh": "seconds, default 120"},
     "reads": ["app.bsky.feed.getAuthorFeed"]},

    {"tag": "dashboard-grid", "src": "dashboard template: /static/embed/grid.js. GovKit has its own copy as <baobab-grid> at https://dash.workers.vc/static/embed/grid.js", "what": "Holds a page's cards; each person arranges them; saved per person", "signin": true, "contract": true,
     "attributes": {"data-up": "the dashboard app", "data-dashboard": "which saved layout", "children": "data-card, data-w (1-12), data-autohide, data-tool"}},
    {"tag": "site-nav", "src": "dashboard template: /static/embed/nav.js", "what": "The dashboard app's bar with an account menu", "signin": false, "contract": true,
