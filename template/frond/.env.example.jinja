{% if backend == 'root' -%}
# Base URL of this frond's root (its Django API). Required.
VITE_API_URL=http://localhost:8000
{%- else -%}
# Base URL of the system this frond reads (e.g. its Taiga or Odoo). Required.
VITE_API_URL=
{%- endif %}
# Script URL of the frame's nav. Set: it replaces this app's top bar. Unset: this app's own top bar.
VITE_NAV_SRC=
# Tag name the nav script defines.
VITE_NAV_TAG=baobab-nav
# Stylesheet of --bb-* variables from the frame, loaded after this app's CSS.
VITE_THEME_CSS=
