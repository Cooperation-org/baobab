import { API_URL } from "@/config"

{% if backend == 'root' -%}
function signIn(): void {
  location.assign(`${API_URL}/auth/login/?next=${encodeURIComponent(location.href)}`)
}
{%- else -%}
// SIGN-IN: send the browser to the system's own login (Taiga: its LinkedTrust
// sign-in from taiga-contrib-linkedtrust-auth; Odoo: auth_oauth), returning to
// location.href. Until then a 401 shows as an error.
function signIn(): void {
  throw new Error("signIn() in src/api.ts is not set up for this system yet.")
}
{%- endif %}

async function request<T>(path: string, init?: RequestInit): Promise<T> {
  const response = await fetch(API_URL + path, { credentials: "include", ...init })
  if (response.status === 401) {
    signIn()
    // The page is leaving for sign-in; nothing should render an error meanwhile.
    return new Promise<T>(() => {})
  }
  if (!response.ok) {
    throw new Error(`${init?.method ?? "GET"} ${path}: ${response.status}`)
  }
  return response.status === 204 ? (undefined as T) : response.json()
}

export function getJSON<T>(path: string): Promise<T> {
  return request<T>(path)
}

export function send<T>(
  method: "POST" | "PUT" | "PATCH" | "DELETE",
  path: string,
  body?: unknown
): Promise<T> {
  return request<T>(path, {
    method,
    headers: { "Content-Type": "application/json", "X-Baobab": "1" },
    body: body === undefined ? undefined : JSON.stringify(body),
  })
}
