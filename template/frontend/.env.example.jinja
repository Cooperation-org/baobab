{% if backend == 'new' -%}
# Base URL of this frontend's backend (its Django API). Required.
VITE_API_URL=http://localhost:8000
{%- else -%}
# Base URL of the system this frontend reads (e.g. its Taiga or Odoo). Required.
VITE_API_URL=
# The system's own login page; the address to come back to is appended, URL-encoded.
# Odoo: https://<host>/web/login?redirect=   Unset: a 401 shows as an error.
VITE_SIGNIN_URL=
{%- endif %}
# Script URL of the dashboard app's nav. Set: it replaces this app's top bar. Unset: this app's own top bar.
VITE_NAV_SRC=
# Tag name the nav script defines.
VITE_NAV_TAG=site-nav
# Stylesheet of --theme-* variables from the dashboard app, loaded after this app's CSS.
VITE_THEME_CSS=
