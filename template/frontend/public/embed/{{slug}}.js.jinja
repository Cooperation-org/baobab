// {{ name }} cards. Vanilla custom elements: no framework, no build step, no
// shadow DOM. Style them from the host page by tag name.
//
//   <{{ slug }}-items data-up="<API_URL>" data-org="<org slug>" data-app="<app URL>" data-limit="5">
//     The org's latest items (data-limit, default 5), one per row, and a link into the app. Hides itself when
//     there is nothing to show.

(function () {
  'use strict';

  var SLUG = '{{ slug }}';
  var APP_NAME = {{ name|tojson }};
  var KIT = new URL('kit.js', document.currentScript.src).href;

  function loadKit() {
    return new Promise(function (resolve, reject) {
      var script = document.createElement('script');
      script.src = KIT;
      script.onload = function () { resolve(window.embedKits[KIT](SLUG)); };
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  function defineItems(kit) {
    if (customElements.get(SLUG + '-items')) return;
    customElements.define(SLUG + '-items', class extends HTMLElement {
      connectedCallback() {
        var org = this.dataset.org;
        if (!org) return kit.hide(this);
        this.path = '/api/orgs/' + encodeURIComponent(org) + '/items/?limit=' +
          encodeURIComponent(this.dataset.limit || '5');
        this.load();
      }

      load() {
        var host = this;
        kit.getJSON(host, host.path).then(function (items) {
          if (!Array.isArray(items) || items.length === 0) return kit.hide(host);
          var list = document.createElement('ul');
          items.forEach(function (item) {
            var row = document.createElement('li');
            row.textContent = item.title;
            list.appendChild(row);
          });
          host.replaceChildren(list);
          var app = host.dataset.app;
          if (app && /^https?:\/\//i.test(app)) {
            var open = document.createElement('a');
            open.href = app.replace(/\/+$/, '') + '/o/' + encodeURIComponent(host.dataset.org) + '/';
            open.textContent = 'Open ' + APP_NAME;
            host.appendChild(open);
          }
          host.hidden = false;
        }).catch(function () { kit.hide(host); });
      }
    });
  }

  loadKit().then(defineItems, function () {
    document.querySelectorAll(SLUG + '-items').forEach(function (card) { card.hidden = true; });
  });
})();
