const env = import.meta.env

if (!env.VITE_API_URL) {
  throw new Error("VITE_API_URL is not set. Copy .env.example to .env.")
}

export const APP_NAME = {{ name|tojson }}
export const API_URL = env.VITE_API_URL.replace(/\/+$/, "")
export const NAV_SRC = env.VITE_NAV_SRC || undefined
export const NAV_TAG = env.VITE_NAV_TAG || "site-nav"
export const THEME_CSS = env.VITE_THEME_CSS || undefined
{%- if backend == 'existing' %}
export const SIGNIN_URL = env.VITE_SIGNIN_URL || undefined
{%- endif %}
