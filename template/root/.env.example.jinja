# {{ name }}: a baobab root. Shared names: CONTRACT.md section 10.
SECRET_KEY=change-me
DEBUG=true
DATABASE_URL=postgres://{{ slug }}:{{ slug }}@localhost:5432/{{ slug }}
ALLOWED_HOSTS=localhost,127.0.0.1

# Sign-in. Register a confidential client at the provider with redirect URI
# https://<this host>/auth/linkedtrust/callback
OIDC_ISSUER=https://live.linkedtrust.us
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_PROVIDERS=linkedtrust

# The frame that knows who is in which org, and the token it gave this root.
FRAME_URL=
S2S_TOKEN=

# Origins of the frond and frames whose pages read this API with credentials.
EMBED_ORIGINS=
